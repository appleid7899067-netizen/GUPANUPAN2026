{
  "name": "docker-agent-puter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ใช้บัญชี Puter (ล็อกอิน) เป็นโมเดลให้ docker-agent ผ่าน Puter OpenAI-compatible endpoint",
  "scripts": {
    "login": "node puter-login.mjs",
    "login:force": "node puter-login.mjs --force",
    "verify": "node puter-login.mjs --verify",
    "verify:ping": "node puter-login.mjs --verify --ping",
    "agent": "./run-agent.sh",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@heyputer/puter.js": "^2.5.3",
    "open": "^10.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
